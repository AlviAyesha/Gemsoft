# Postgres connection (Neon, Supabase, Railway or your own server)
DATABASE_URL=postgres://user:password@host:5432/gemsoft
# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=
# Public address of the site, no trailing slash (used for canonical URLs, sitemap and schema)
NEXT_PUBLIC_SERVER_URL=https://www.gemsoft.example
# Optional: SMTP for contact and job application emails. Without it, emails are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@gemsoft.example
# Staging: set a password to lock the whole site (any username) and keep it out of Google. Leave empty in production.
STAGING_PASSWORD=
# Optional: Google Analytics 4 id (G-XXXXXXX). Loads only after a visitor accepts the cookie notice.
NEXT_PUBLIC_GA_ID=
# Uploads (images, CVs) on S3-compatible storage: Cloudflare R2, AWS S3, Supabase Storage.
# Required on Vercel. Without S3_BUCKET, files are saved on the server's disk.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# docker-compose only: password for the bundled Postgres
POSTGRES_PASSWORD=
