# Postgres connection (Neon, Supabase, Railway or your own server)
DATABASE_URL=postgres://user:password@host:5432/gemsoft
# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=
# Public address of the site, no trailing slash (used for canonical URLs, sitemap and schema)
NEXT_PUBLIC_SERVER_URL=https://www.gemsoft.example
# Protects draft previews
PREVIEW_SECRET=
# Optional: SMTP for contact and job application emails. Without it, emails are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@gemsoft.example
# Optional: Cloudflare Turnstile spam check on forms
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
